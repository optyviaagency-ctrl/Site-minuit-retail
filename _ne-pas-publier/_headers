# En-têtes de sécurité — format Netlify / Cloudflare Pages.
# (Vercel : voir vercel.json ; Apache : .htaccess ; Nginx : add_header.)
# La vraie protection d'un site statique vient d'ici, pas d'un build.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self' https://formsubmit.co; form-action 'self' mailto:

# NB : le formulaire envoie les leads via FormSubmit (connect-src https://formsubmit.co, déjà ajouté).
# À l'activation de l'analytics (Plausible), étendre la CSP :
#   script-src  … https://plausible.io
#   connect-src … https://plausible.io
